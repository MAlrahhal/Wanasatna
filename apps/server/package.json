{
  "name": "@wanasatna/server",
  "version": "0.1.0",
  "private": true,
  "description": "Wanasatna real-time API and Socket.IO server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "pnpm --filter @wanasatna/shared build && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "test:unit": "tsx tests/unit.test.ts",
    "test:multiplayer": "tsx tests/multiplayer.integration.test.ts",
    "test:lifecycle": "tsx tests/lifecycle.integration.test.ts",
    "test:reconnect": "tsx tests/reconnect.integration.test.ts",
    "test:fresh-join": "tsx tests/fresh-join.integration.test.ts",
    "test:hardening": "tsx tests/qa-hardening.integration.test.ts",
    "test:server": "cross-env WANASATNA_TEST_MODE=1 PORT=4001 CLIENT_ORIGIN=http://localhost:3000 tsx src/index.ts",
    "test:all": "pnpm run test:unit && pnpm run test:multiplayer && pnpm run test:lifecycle && pnpm run test:reconnect && pnpm run test:fresh-join && pnpm run test:hardening"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@wanasatna/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "prisma": "^6.2.1",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  }
}
