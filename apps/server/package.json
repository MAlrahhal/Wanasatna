{
  "name": "@wanasatna/server",
  "version": "0.1.0",
  "private": true,
  "description": "Wanasatna real-time API and Socket.IO server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "pnpm --filter @wanasatna/shared build && prisma generate && tsx watch src/index.ts",
    "build": "pnpm --filter @wanasatna/shared build && prisma generate && tsc -p tsconfig.json",
    "start": "prisma migrate deploy && node dist/index.js",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "test:database-url-guard": "tsx tests/database-url-guard.unit.test.ts",
    "test:security-batch1": "tsx tests/security-batch1.unit.test.ts",
    "test:security-batch2": "tsx tests/security-batch2.unit.test.ts",
    "test:security-batch3": "cross-env WANASATNA_TEST_MODE=1 ADMIN_TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef tsx tests/security-batch3-mfa.integration.test.ts && tsx tests/security-batch3-audit.unit.test.ts",
    "test:unit": "tsx tests/unit.test.ts && tsx tests/graceful-shutdown.unit.test.ts && tsx tests/room-returnability.unit.test.ts && tsx tests/room-content-history.unit.test.ts",
    "test:content-history": "tsx tests/room-content-history.unit.test.ts",
    "test:room-chat": "tsx tests/room-chat.unit.test.ts",
    "test:p12-b2": "tsx tests/p12-b2-room-lifecycle.unit.test.ts",
    "test:presence-reconnect": "tsx tests/presence-reconnect-race.unit.test.ts",
    "test:p12-b3": "cross-env WANASATNA_TEST_MODE=1 tsx tests/p12-b3-auth.unit.test.ts",
    "test:p13-a": "cross-env WANASATNA_TEST_MODE=1 tsx tests/p13-a-admin.unit.test.ts",
    "test:p13-b": "cross-env WANASATNA_TEST_MODE=1 tsx tests/p13-b-admin.unit.test.ts",
    "test:p13-c": "cross-env WANASATNA_TEST_MODE=1 tsx tests/p13-c-admin.unit.test.ts",
    "test:p13-d": "cross-env WANASATNA_TEST_MODE=1 tsx tests/p13-d-admin.unit.test.ts",
    "test:p13-e": "cross-env WANASATNA_TEST_MODE=1 tsx tests/p13-e-admin.unit.test.ts",
    "test:p13-f": "cross-env WANASATNA_TEST_MODE=1 tsx tests/p13-f-admin.unit.test.ts",
    "test:p13-g": "cross-env WANASATNA_TEST_MODE=1 tsx tests/p13-g-admin.unit.test.ts",
    "test:answer-attempt": "cross-env WANASATNA_TEST_MODE=1 tsx tests/answer-attempt.unit.test.ts",
    "test:p14-a": "cross-env WANASATNA_TEST_MODE=1 tsx tests/p14-a-admin.unit.test.ts",
    "test:p14-b": "cross-env WANASATNA_TEST_MODE=1 tsx tests/p14-b-product-analytics.unit.test.ts",
    "test:p14-c": "cross-env WANASATNA_TEST_MODE=1 tsx tests/p14-c-admin.unit.test.ts",
    "test:admin-history-write": "cross-env WANASATNA_TEST_MODE=1 tsx tests/admin-history-write-path.unit.test.ts",
    "test:admin-room-history": "cross-env WANASATNA_TEST_MODE=1 tsx tests/admin-room-history.unit.test.ts",
    "test:admin-spectate": "cross-env WANASATNA_TEST_MODE=1 tsx tests/admin-spectate.unit.test.ts",
    "promote-admin": "tsx scripts/promote-admin.ts",
    "admin-mfa": "tsx scripts/admin-mfa.ts",
    "test:p12-b5": "cross-env WANASATNA_TEST_MODE=1 tsx tests/p12-b5-socket-account.unit.test.ts",
    "test:p12-b6": "cross-env WANASATNA_TEST_MODE=1 tsx tests/p12-b6-match-history.unit.test.ts",
    "test:p12-b7": "cross-env WANASATNA_TEST_MODE=1 tsx tests/p12-b7-db-hardening.unit.test.ts",
    "test:p12-b72": "cross-env WANASATNA_TEST_MODE=1 tsx tests/p12-b72-legacy-schema.unit.test.ts",
    "test:shutdown": "tsx tests/graceful-shutdown.unit.test.ts",
    "test:content": "tsx tests/content-validation.unit.test.ts && tsx tests/content-contract.unit.test.ts",
    "test:plugin-registry": "tsx tests/plugin-registry.unit.test.ts",
    "test:marathon": "tsx tests/marathon.unit.test.ts",
    "test:timing-challenge": "tsx tests/timing-challenge.unit.test.ts",
    "test:timing-challenge:integration": "tsx tests/timing-challenge.integration.test.ts",
    "test:fast-answer": "tsx tests/fast-answer.unit.test.ts",
    "test:fast-answer:integration": "tsx tests/fast-answer.integration.test.ts",
    "test:room-abuse": "tsx tests/room-socket-abuse.unit.test.ts",
    "test:draw-guess": "tsx tests/draw-guess.unit.test.ts && tsx tests/drawing-performance.unit.test.ts && tsx tests/drawing-security.unit.test.ts",
    "test:draw-guess:integration": "tsx tests/draw-guess.integration.test.ts",
    "test:imposter-draw": "tsx tests/imposter-draw.unit.test.ts && tsx tests/drawing-performance.unit.test.ts && tsx tests/drawing-security.unit.test.ts",
    "test:imposter-draw:integration": "tsx tests/imposter-draw.integration.test.ts",
    "test:who-wrote-it": "tsx tests/who-wrote-it.unit.test.ts",
    "test:who-wrote-it:integration": "tsx tests/who-wrote-it.integration.test.ts",
    "test:judge": "tsx tests/judge.unit.test.ts",
    "test:judge:integration": "tsx tests/judge.integration.test.ts",
    "test:guessing-challenge": "tsx tests/guessing-challenge.unit.test.ts",
    "test:guessing-challenge:integration": "tsx tests/guessing-challenge.integration.test.ts",
    "test:multiplayer": "tsx tests/multiplayer.integration.test.ts",
    "test:lifecycle": "tsx tests/lifecycle.integration.test.ts",
    "test:reconnect": "tsx tests/reconnect.integration.test.ts",
    "test:fresh-join": "tsx tests/fresh-join.integration.test.ts",
    "test:hardening": "tsx tests/qa-hardening.integration.test.ts",
    "test:room-lifecycle": "tsx tests/room-lifecycle.integration.test.ts",
    "test:pregame-teams": "tsx tests/pregame-teams.unit.test.ts",
    "test:pregame-teams:integration": "tsx tests/pregame-teams.integration.test.ts",
    "test:restart-game": "tsx tests/restart-game.integration.test.ts",
    "test:game-shell-lifecycle": "tsx tests/game-shell-lifecycle.integration.test.ts",
    "test:endgame-roster": "tsx tests/endgame-roster.integration.test.ts",
    "test:cross-room-identity": "tsx tests/cross-room-identity.integration.test.ts",
    "test:server": "cross-env WANASATNA_TEST_MODE=1 PORT=4001 CLIENT_ORIGIN=http://localhost:3000 tsx src/index.ts",
    "test:all": "pnpm run test:unit && pnpm run test:multiplayer && pnpm run test:lifecycle && pnpm run test:reconnect && pnpm run test:fresh-join && pnpm run test:hardening && pnpm run test:room-lifecycle && pnpm run test:restart-game && pnpm run test:game-shell-lifecycle && pnpm run test:endgame-roster"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@wanasatna/shared": "workspace:*",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "otpauth": "9.5.1",
    "prisma": "^6.2.1",
    "socket.io": "^4.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  }
}
