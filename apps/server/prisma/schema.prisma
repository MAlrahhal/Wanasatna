// Prisma schema for Wanasatna — Sprint 1: Core Room System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RoomStatus {
  LOBBY
  PLAYING
  CLOSED
}

enum PlayerStatus {
  CONNECTED
  DISCONNECTED
  LEFT
}

enum UserRole {
  USER
  ADMIN
}

enum MatchStatus {
  ACTIVE
  COMPLETED
  ABORTED
}

enum ProductEventType {
  ROOM_CREATED
  ROOM_JOINED
  SPECTATOR_JOINED
  RECONNECT_SUCCEEDED
  ROOM_CLOSED
}

enum RoomCloseReason {
  ROOM_EMPTY
  HOST_ENDED
  ADMIN_FORCE_CLOSED
  STARTUP_RECONCILIATION
}

enum AnswerAttemptStatus {
  CORRECT_COUNTED
  CORRECT_NOT_COUNTED
  WRONG_COUNTED
  WRONG_NOT_COUNTED
  REJECTED
  LATE
  OUT_OF_TURN
  DUPLICATE
}

enum AnswerRejectReason {
  VALIDATION
  NOT_PARTICIPANT
  INVALID_ROLE
  RECOVERY
  EMPTY
  OVERSIZED
  GAME_NOT_READY
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Room {
  id           String     @id @default(cuid())
  code         String     @unique
  hostPlayerId String     @unique
  historyId    String?    @unique
  status       RoomStatus @default(LOBBY)
  isLocked     Boolean    @default(false)
  playerCap    Int        @default(8)
  gameSettings Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  hostPlayer Player        @relation("RoomHost", fields: [hostPlayerId], references: [id], onDelete: Restrict)
  history    RoomHistory?  @relation("LiveRoomHistory", fields: [historyId], references: [id], onDelete: Restrict)
  players    Player[]      @relation("RoomPlayers")
  matches    Match[]
  messages   RoomMessage[]

  @@index([status])
}

// Permanent room identity and lifecycle snapshots. This row survives live Room deletion.
model RoomHistory {
  id                  String           @id @default(cuid())
  liveRoomId          String           @unique
  roomCode            String
  originalHostName    String?
  currentHostPlayerId String
  currentHostName     String
  playerCap           Int
  isLocked            Boolean
  wasEverLocked       Boolean?
  createdByAdmin      Boolean?
  isComplete          Boolean          @default(true)
  createdAt           DateTime
  historyStartedAt    DateTime         @default(now())
  closedAt            DateTime?
  closeReason         RoomCloseReason?
  updatedAt           DateTime         @updatedAt

  liveRoom        Room?                      @relation("LiveRoomHistory")
  participations  RoomParticipationHistory[]
  hostChanges     RoomHostHistory[]
  matches         Match[]
  answerAttempts  AnswerAttempt[]

  @@index([createdAt])
  @@index([closedAt])
  @@index([roomCode])
}

model RoomParticipationHistory {
  id                String    @id @default(cuid())
  roomHistoryId     String
  livePlayerId      String
  displayName       String
  joinedAt          DateTime
  leftAt            DateTime?
  joinedAsSpectator Boolean?
  wasHost           Boolean?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  roomHistory RoomHistory @relation(fields: [roomHistoryId], references: [id], onDelete: Cascade)

  @@unique([roomHistoryId, livePlayerId])
  @@index([roomHistoryId, joinedAt])
  @@index([displayName])
}

model RoomHostHistory {
  id            String   @id @default(cuid())
  roomHistoryId String
  livePlayerId  String
  displayName   String
  assignedAt    DateTime

  roomHistory RoomHistory @relation(fields: [roomHistoryId], references: [id], onDelete: Cascade)

  @@unique([roomHistoryId, livePlayerId])
  @@index([roomHistoryId, assignedAt])
}

model Player {
  id           String       @id @default(cuid())
  roomId       String
  name         String
  status       PlayerStatus @default(CONNECTED)
  isSpectator  Boolean      @default(false)
  joinedAt     DateTime     @default(now())
  lastSeenAt         DateTime     @default(now())
  reconnectTokenHash String?
  userId             String?

  room               Room               @relation("RoomPlayers", fields: [roomId], references: [id], onDelete: Cascade)
  hostedRoom         Room?              @relation("RoomHost")
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  matchParticipations MatchParticipant[]
  roomMessages        RoomMessage[]

  @@unique([roomId, name])
  @@index([roomId])
  @@index([status])
  @@index([status, lastSeenAt])
  @@index([userId])
}

// Persistent website account. Separate from room-scoped Player.
model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  passwordHash         String
  preferredDisplayName String
  role                 UserRole              @default(USER)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  authSessions         AuthSession[]
  adminTotpCredential  AdminTotpCredential?
  adminMfaChallenges   AdminMfaChallenge[]
  adminRecoveryCodes   AdminRecoveryCode[]
  adminAuditLogs       AdminAuditLog[]        @relation("AdminAuditActor")
  players              Player[]
  matchParticipations  MatchParticipant[]
}

// Opaque DB-backed login session. Separate from room-scoped Player.
model AuthSession {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  mfaVerifiedAt DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AdminTotpCredential {
  id              String    @id @default(cuid())
  userId          String    @unique
  encryptedSecret String
  keyVersion      Int       @default(1)
  enabledAt       DateTime?
  lastUsedStep    Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminMfaChallenge {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AdminRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  occurredAt  DateTime @default(now())
  actorUserId String?
  action      String
  targetType  String?
  targetId    String?
  outcome     String
  requestId   String?
  metadata    Json?
  actor       User?    @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([action, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([targetType, targetId, occurredAt])
}

// Durable match history only. Live Game Shell / plugin runtime stay memory-only.
model Match {
  id            String      @id @default(cuid())
  roomId        String?
  roomHistoryId String?
  roomCode      String
  gameId        String
  status        MatchStatus @default(ACTIVE)
  startedAt     DateTime    @default(now())
  endedAt       DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  room           Room?              @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomHistory    RoomHistory?       @relation(fields: [roomHistoryId], references: [id], onDelete: Restrict)
  participants   MatchParticipant[]
  answerAttempts AnswerAttempt[]

  @@index([roomId])
  @@index([roomHistoryId])
  @@index([status])
  @@index([gameId])
  @@index([startedAt])
  @@index([roomId, status])
}

model MatchParticipant {
  id          String   @id @default(cuid())
  matchId     String
  playerId    String?
  userId      String?
  displayName String
  score       Int?
  rank        Int?
  team        String?
  isWinner    Boolean?
  createdAt   DateTime @default(now())

  match  Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([matchId])
  @@index([userId])
  @@index([playerId])
}

// Support/debug log of authoritative answer attempts. Purged after 30 days.
// Does not keep live Room/Player FKs because those rows disappear with the room.
model AnswerAttempt {
  id                String              @id @default(cuid())
  roomHistoryId     String
  matchId           String
  gameId            String
  submittedAt       DateTime            @default(now())
  livePlayerId      String?
  playerDisplayName String
  rawAnswer         String              @db.VarChar(200)
  normalizedAnswer  String?             @db.VarChar(200)
  status            AnswerAttemptStatus
  rejectReason      AnswerRejectReason?
  wasCorrect        Boolean?
  wasCounted        Boolean
  pointsAwarded     Int                 @default(0)
  roundIndex        Int?
  roundId           String?
  turnId            String?
  promptId          String?
  promptText        String              @db.VarChar(200)
  teamId            String?

  roomHistory RoomHistory @relation(fields: [roomHistoryId], references: [id], onDelete: Cascade)
  match       Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, submittedAt])
  @@index([roomHistoryId, submittedAt])
  @@index([submittedAt])
  @@index([gameId, submittedAt])
  @@index([matchId, status, submittedAt])
}

model RoomMessage {
  id                  String   @id @default(cuid())
  roomId              String
  playerId            String?
  senderNameSnapshot  String
  content             String
  createdAt           DateTime @default(now())

  room   Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
}

model GameAdminConfig {
  gameId    String   @id
  isEnabled Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// Product usage events only. No people, Room codes, or Match duplicates.
// roomId is a historical correlation string, not a foreign key.
model ProductEvent {
  id          String           @id @default(cuid())
  type        ProductEventType
  roomId      String?
  gameId      String?
  roomCap     Int?
  playerCount Int?
  createdAt   DateTime         @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
  @@index([roomId])
}
