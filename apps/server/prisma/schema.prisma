// Prisma schema for Wanasatna — Sprint 1: Core Room System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RoomStatus {
  LOBBY
  PLAYING
  CLOSED
}

enum PlayerStatus {
  CONNECTED
  DISCONNECTED
  LEFT
}

enum UserRole {
  USER
  ADMIN
}

enum MatchStatus {
  ACTIVE
  COMPLETED
  ABORTED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Room {
  id              String        @id @default(cuid())
  code            String        @unique
  hostPlayerId    String        @unique
  status          RoomStatus    @default(LOBBY)
  isLocked        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hostPlayer      Player        @relation("RoomHost", fields: [hostPlayerId], references: [id], onDelete: Restrict)
  players         Player[]      @relation("RoomPlayers")
  matches         Match[]

  @@index([status])
}

model Player {
  id           String       @id @default(cuid())
  roomId       String
  name         String
  status       PlayerStatus @default(CONNECTED)
  isSpectator  Boolean      @default(false)
  joinedAt     DateTime     @default(now())
  lastSeenAt         DateTime     @default(now())
  reconnectTokenHash String?
  userId             String?

  room               Room               @relation("RoomPlayers", fields: [roomId], references: [id], onDelete: Cascade)
  hostedRoom         Room?              @relation("RoomHost")
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  matchParticipations MatchParticipant[]

  @@unique([roomId, name])
  @@index([roomId])
  @@index([status])
  @@index([status, lastSeenAt])
  @@index([userId])
}

// Persistent website account. Separate from room-scoped Player.
model User {
  id                   String        @id @default(cuid())
  email                String        @unique
  passwordHash         String
  preferredDisplayName String
  role                 UserRole      @default(USER)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  authSessions         AuthSession[]
  players              Player[]
  matchParticipations  MatchParticipant[]
}

// Opaque DB-backed login session. Separate from room-scoped Player.
model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Durable match history only. Live Game Shell / plugin runtime stay memory-only.
model Match {
  id        String      @id @default(cuid())
  roomId    String?
  roomCode  String
  gameId    String
  status    MatchStatus @default(ACTIVE)
  startedAt DateTime    @default(now())
  endedAt   DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  room         Room?              @relation(fields: [roomId], references: [id], onDelete: SetNull)
  participants MatchParticipant[]

  @@index([roomId])
  @@index([status])
  @@index([gameId])
  @@index([startedAt])
  @@index([roomId, status])
}

model MatchParticipant {
  id          String   @id @default(cuid())
  matchId     String
  playerId    String?
  userId      String?
  displayName String
  score       Int?
  rank        Int?
  team        String?
  isWinner    Boolean?
  createdAt   DateTime @default(now())

  match  Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([matchId])
  @@index([userId])
  @@index([playerId])
}
