NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Required only for admin TOTP enrollment and MFA login. Exactly 32 bytes as 64 hex characters.
ADMIN_TOTP_ENCRYPTION_KEY=replace-with-64-hex-characters

# Required for purchaser email OTP. Use an independent random secret of at least 32 characters.
PURCHASER_OTP_SECRET=replace-with-an-independent-random-secret

# Required for production OTP delivery after verifying the sender domain in Resend.
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=Wanasatna <access@example.com>

# Development database only. Keep the production URL in Railway.
DATABASE_URL=postgresql://user:password@localhost:5432/wanasatna_dev

# Required by automated DB-backed tests. It must use loopback and an explicitly test-marked name.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/wanasatna_test
